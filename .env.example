# ==============================================================================
# ENVIRONMENT VARIABLES - DEPLOYMENT GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vercel)
# Add these variables to your Vercel Project Settings > Environment Variables
# ------------------------------------------------------------------------------
# Point this to your Render backend URL (e.g. https://campuseventhub-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Point this to your Render AI service URL (e.g. https://campuseventhub-ai.onrender.com)
VITE_AI_URL=http://localhost:8001


# ------------------------------------------------------------------------------
# 2. BACKEND (Render)
# Add these to the Render Dashboard (or let Render sync what it can via Blueprint)
# ------------------------------------------------------------------------------
# Your MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/CampusEventHub?retryWrites=true&w=majority

# JWT Authentication Secret (Render will generate one automatically if you leave it blank)
# JWT_SECRET=supersecretkey

# Optional: Cloudinary (If using image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Email Service (If sending registration emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
